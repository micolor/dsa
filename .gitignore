# 环境变量文件（包含敏感信息，禁止提交）
.env
.env.*
*.env
*.env.local
.env.*.local

# 测试文件（可能包含敏感配置）
# 仅忽略仓库根目录下的临时 test_*.py 脚本；tests/ 目录下的单元测试需要纳入版本控制。
/test_*.py
/test.sh

