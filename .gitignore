# git-bash 崩溃转储
*.stackdump

# 测试
.pytest_cache/
.coverage
htmlcov/

local/

run.sh

verify_*.py

# ignore Claude workspace artifacts, but keep shared repo skills versioned
.claude/*
!.claude/skills/
!.claude/skills/**
# `!.claude/skills/**` 会把该目录下的一切重新纳入跟踪，含系统垃圾文件；gitignore
# 后匹配优先，所以在它后面再把这两类排除掉，否则 `git add -A` 会把 .DS_Store 入库。
.claude/skills/**/.DS_Store
.claude/skills/**/Thumbs.db

# ignore static files
static/
/apps/dsa-desktop/dist/
/apps/dsa-desktop/node_modules/
/node_modules/
docs/specs/

# 本地后端运行日志
backend.out.log
backend.err.log
backend.serve.log
backend.serve.err.log
tmp_server_server.log

# 一次性验收 / 审计截图：按 AGENTS.md 不得作为仓库文件合入，只放在 PR 描述或外部证据链接
.screenshots/

# superpowers 协作 skill 的本地工作区（根目录那份自带 `*` 的 .gitignore，子目录里的不会）
.superpowers/
